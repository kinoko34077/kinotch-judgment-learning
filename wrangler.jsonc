{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kinotch-judgment-learning",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinotch-judgment-learning",
      "database_id": "d503a90d-4c9f-4f98-80bf-ebe427aac12d"
    }
  ],
  "keep_vars": true
}
