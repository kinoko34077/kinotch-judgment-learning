{
  "name": "kinotch-judgment-learning",
  "compatibility_date": "2026-10-17",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "main": "worker/index.js",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kinotch-judgment-learning",
      "database_id": "d503a90d-4c9f-4f98-80bf-ebe427aac12d"
    }
  ],
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMIT",
      "namespace_id": "41101926",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "secrets": {
    "required": [
      "GITHUB_CLIENT_ID",
      "GITHUB_CLIENT_SECRET"
    ]
  },
  "vars": {
    "OWNER_GITHUB_USER_ID": "79015263",
    "PUBLIC_ORIGIN": "https://kinotch-judgment-learning.kinotch.workers.dev"
  }
}
